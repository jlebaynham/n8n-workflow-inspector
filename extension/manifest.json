{
  "manifest_version": 3,
  "name": "Workflow Inspector for n8n",
  "short_name": "Workflow Inspector",
  "version": "1.0.0",
  "description": "Explains any n8n workflow in plain English and checks it for API keys, personal details and IDs before you share it.",
  "homepage_url": "https://baynhams.dev",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Workflow Inspector",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
