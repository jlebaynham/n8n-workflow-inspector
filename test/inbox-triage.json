            "Subject": "={{ $('Read result').item.json.subject }}",
            "Category": "={{ $('Read result').item.json.category }}",
            "Urgent": "={{ $('Read result').item.json.urgent }}",
            "Summary": "={{ $('Read result').item.json.summary }}",
            "From": "={{ $('New email').item.json.headers.from.replace('From: ', '') }}"
          },
          "matchingColumns": [],
          "schema": [
            {
